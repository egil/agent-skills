{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/role-guard.sh\"",
            "timeout": 15,
            "statusMessage": "Checking delivery role boundary..."
          }
        ]
      }
    ]
  }
}
